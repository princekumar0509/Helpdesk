# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Never put AWS access keys here — use `aws configure` / AWS SSO instead.

aws_region          = "ap-south-1"
project             = "helpdesk"
environment         = "dev"
cluster_version     = "1.34"
# AWS Free plan accounts can only launch free-tier types (t3.medium is rejected); m7i-flex.large = 2 vCPU / 8 GiB.
node_instance_types = ["m7i-flex.large"]
node_desired_size   = 2

# Enables keyless GitHub Actions deploys (OIDC). Set to "" to skip.
github_repository = "princekumar0509/devops-heros"
# Set to false if `aws iam list-open-id-connect-providers` already shows token.actions.githubusercontent.com
create_github_oidc_provider = true
